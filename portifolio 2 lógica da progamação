programa exercicio 2

{

funcao inicio()

{

inteiro numero, contador



escreva("Digite um numero inteiro positivo: ")

leia(numero)

 

escreva("\n Tabuada do ", numero, ": \n")



para(contador = 1; contador <= 10; contador++)

{

escreva(numero, " x ", contador, " = ", numero * contador, " \n")

}

}

}





